table Consultas
	lineageTag: 11937d29-db1a-4a6e-84ed-cb810cec00d4

	measure 'Total de consultas' = COUNTROWS(Consultas) + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: 828c01e0-2460-4257-ad31-1d76f5046a0d

	measure 'Realizadas' = CALCULATE(COUNTROWS(Consultas), Consultas[Status] = "Realizada") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: b188b484-0cd8-4dcd-a1fa-0e664f7c57bf

	measure 'Faltas' = CALCULATE(COUNTROWS(Consultas), Consultas[Status] = "Faltou") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: dda0a932-99a0-4838-8f17-8cdd52eb348f

	measure 'Próximas' = CALCULATE(COUNTROWS(Consultas), Consultas[Status] IN {"Agendada", "Confirmada"}, Consultas[Início] >= NOW()) + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: 0d23e640-a0e5-4baa-a7a8-d7b594de4b7e

	measure 'Próximos 7 dias' = CALCULATE(COUNTROWS(Consultas), Consultas[Status] IN {"Agendada", "Confirmada"}, Consultas[Início] >= NOW(), Consultas[Início] < NOW() + 7) + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: 5cab79be-4a0e-48d3-acd3-b73c3fae1152

	measure 'Não confirmadas' = CALCULATE(COUNTROWS(Consultas), Consultas[Status] = "Agendada", Consultas[Início] >= NOW()) + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: c3a028c8-b5e2-4561-aaf7-dd8c6215e5b8

	measure 'Taxa de comparecimento' = VAR r = [Realizadas] VAR f = [Faltas] RETURN IF(r + f = 0, BLANK(), DIVIDE(r, r + f))
		formatString: 0%
		displayFolder: Relatório
		lineageTag: 70bc91f3-5435-4201-8e52-657c29c9c051

	measure 'Adesão média' = AVERAGE(Consultas[Adesão (0-10)])
		formatString: 0.0
		displayFolder: Relatório
		lineageTag: 7416fe6b-7339-4a69-a27c-a69e09a0f542

	measure 'Adesão média (texto)' = IF(ISBLANK([Adesão média]), "–", FORMAT([Adesão média], "0.0"))
		displayFolder: Relatório
		lineageTag: 3dedf1f4-15cd-424e-9ce8-2eff447c21f1

	measure 'Atendimentos por atleta' = DIVIDE([Realizadas], CALCULATE(DISTINCTCOUNT(Consultas[Atleta]), Consultas[Status] = "Realizada"))
		formatString: 0.0
		displayFolder: Relatório
		lineageTag: 96b0263b-5c02-4eed-a301-2b9f941c956d

	measure 'Taxa de comparecimento (texto)' = IF(ISBLANK([Taxa de comparecimento]), "–", FORMAT([Taxa de comparecimento], "0%"))
		displayFolder: Relatório
		lineageTag: 745f282c-0910-4a41-8cd6-f262b5a29d5c

