	column 'Semana' = IF(ISBLANK(Consultas[Data]), BLANK(), Consultas[Data] - WEEKDAY(Consultas[Data], 2) + 1)
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: d4fe90a2-fb2f-49db-b2ea-5c3c9177cd42
		summarizeBy: none

	column 'Quando' = IF(Consultas[Início] >= NOW(), "Próxima", "Passada")
		dataType: string
		lineageTag: 1c9796d0-c1b7-4732-a419-dce664ab4a20
		summarizeBy: none

	column 'Data e hora' = FORMAT(Consultas[Início], "dd/mm/yyyy hh:nn")
		dataType: string
		lineageTag: aa840b7f-605d-43dd-8863-f209b4ce6b15
		summarizeBy: none

	partition Consultas = m
		mode: import
		source =
				let
				    Fonte = fnAba("Consultas"),
				    Colunas = Table.SelectColumns(Fonte, {"ID", "Atleta", "Data", "Hora", "Duração (min)", "Tipo", "Modalidade", "Status", "Objetivo / queixa", "Resumo e condutas", "Próximo retorno", "Nº do atendimento", "Hábitos / recordatório", "Plano entregue", "Suplementação prescrita", "Adesão (0-10)", "Sintomas / observações"}, MissingField.UseNull),
				    Tipos = Table.TransformColumns(Colunas, {{"ID", fnNumero, type nullable number}, {"Atleta", fnTexto, type nullable text}, {"Data", fnData, type nullable date}, {"Hora", fnHora, type time}, {"Duração (min)", fnNumero, type nullable number}, {"Tipo", fnTexto, type nullable text}, {"Modalidade", fnTexto, type nullable text}, {"Status", fnTexto, type nullable text}, {"Objetivo / queixa", fnTexto, type nullable text}, {"Resumo e condutas", fnTexto, type nullable text}, {"Próximo retorno", fnData, type nullable date}, {"Nº do atendimento", fnNumero, type nullable number}, {"Hábitos / recordatório", fnTexto, type nullable text}, {"Plano entregue", fnTexto, type nullable text}, {"Suplementação prescrita", fnTexto, type nullable text}, {"Adesão (0-10)", fnNumero, type nullable number}, {"Sintomas / observações", fnTexto, type nullable text}}),
				    Linhas = Table.SelectRows(Tipos, each [Atleta] <> null),
				    Unicos = Linhas,
				    Inicio = Table.AddColumn(Unicos, "Início", each if [Data] = null then null else [Data] & [Hora], type nullable datetime),
				    SemHora = Table.RemoveColumns(Inicio, {"Hora"}),
				    Resultado = Table.ReplaceValue(SemHora, each [Status], each if [Status] = null then "Agendada" else [Status], Replacer.ReplaceValue, {"Status"})
				in
				    Resultado

	annotation PBI_ResultType = Table
