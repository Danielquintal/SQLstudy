	measure 'Peso atual' = AVERAGEX(VALUES(Avaliacoes[Atleta]), VAR d = CALCULATE(MAX(Avaliacoes[Data]), NOT ISBLANK(Avaliacoes[Peso (kg)])) RETURN CALCULATE(AVERAGE(Avaliacoes[Peso (kg)]), Avaliacoes[Data] = d))
