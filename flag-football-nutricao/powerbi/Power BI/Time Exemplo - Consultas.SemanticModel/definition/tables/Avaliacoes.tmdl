	measure 'Peso inicial' = AVERAGEX(VALUES(Avaliacoes[Atleta]), VAR d = CALCULATE(MIN(Avaliacoes[Data]), NOT ISBLANK(Avaliacoes[Peso (kg)])) RETURN CALCULATE(AVERAGE(Avaliacoes[Peso (kg)]), Avaliacoes[Data] = d))
