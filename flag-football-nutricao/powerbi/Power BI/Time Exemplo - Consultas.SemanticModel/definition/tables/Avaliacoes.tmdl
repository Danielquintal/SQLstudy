	column 'Observações'
		dataType: string
		lineageTag: e83366f7-f807-45aa-aa5c-41c846db1913
		summarizeBy: none
		sourceColumn: Observações

	column 'Nome curto' = RELATED(Atletas[Nome curto])
		dataType: string
		lineageTag: b965afe6-2957-486f-9ce9-429f83618793
		summarizeBy: none

	column 'Posição' = RELATED(Atletas[Posição 1])
		dataType: string
		lineageTag: 46102ead-1494-41df-9b19-de0bece12424
		summarizeBy: none

	column 'Idade' = VAR n = RELATED(Atletas[Data de nascimento]) RETURN IF(ISBLANK(n) || ISBLANK(Avaliacoes[Data]), BLANK(), INT(YEARFRAC(n, Avaliacoes[Data])))
		dataType: int64
		formatString: 0
		lineageTag: 4e587118-d050-4b1d-9616-c3e148a2d169
		summarizeBy: none

	column 'Soma 7 dobras (mm)' = IF(ISBLANK(Avaliacoes[Dobra tríceps (mm)]) || ISBLANK(Avaliacoes[Dobra subescapular (mm)]) || ISBLANK(Avaliacoes[Dobra peitoral (mm)]) || ISBLANK(Avaliacoes[Dobra axilar média (mm)]) || ISBLANK(Avaliacoes[Dobra suprailíaca (mm)]) || ISBLANK(Avaliacoes[Dobra abdominal (mm)]) || ISBLANK(Avaliacoes[Dobra coxa medial (mm)]), BLANK(), Avaliacoes[Dobra tríceps (mm)] + Avaliacoes[Dobra subescapular (mm)] + Avaliacoes[Dobra peitoral (mm)] + Avaliacoes[Dobra axilar média (mm)] + Avaliacoes[Dobra suprailíaca (mm)] + Avaliacoes[Dobra abdominal (mm)] + Avaliacoes[Dobra coxa medial (mm)])
		dataType: double
		formatString: 0.0
		lineageTag: eab50c8a-8d2a-4cf0-9e73-9cbd9fc471d5
		summarizeBy: none

	column '% Gordura Pollock 7' = VAR s = Avaliacoes[Soma 7 dobras (mm)] VAR i = Avaliacoes[Idade] RETURN IF(ISBLANK(s) || ISBLANK(i), BLANK(), 495 / (1.112 - 0.00043499 * s + 0.00000055 * s * s - 0.00028826 * i) - 450)
		dataType: double
		formatString: 0.0
		lineageTag: 7493289a-e7bd-4b03-8763-df0362e9d96e
		summarizeBy: none

	column '% Gordura Faulkner' = VAR s = IF(ISBLANK(Avaliacoes[Dobra tríceps (mm)]) || ISBLANK(Avaliacoes[Dobra subescapular (mm)]) || ISBLANK(Avaliacoes[Dobra suprailíaca (mm)]) || ISBLANK(Avaliacoes[Dobra abdominal (mm)]), BLANK(), Avaliacoes[Dobra tríceps (mm)] + Avaliacoes[Dobra subescapular (mm)] + Avaliacoes[Dobra suprailíaca (mm)] + Avaliacoes[Dobra abdominal (mm)]) RETURN IF(ISBLANK(s), BLANK(), 0.153 * s + 5.783)
		dataType: double
		formatString: 0.0
		lineageTag: ef17dbbf-b357-4d29-b6b1-c44d8a7b79d5
		summarizeBy: none

	column '% Gordura' = IF(NOT ISBLANK(Avaliacoes[% Gordura Faulkner]), Avaliacoes[% Gordura Faulkner], Avaliacoes[% Gordura Pollock 7])
		dataType: double
		formatString: 0.0
		lineageTag: bf43735b-774a-43b5-8f26-0fc672e4f701
		summarizeBy: none

	column 'Massa adiposa (kg)' = IF(ISBLANK(Avaliacoes[% Gordura]) || ISBLANK(Avaliacoes[Peso (kg)]), BLANK(), Avaliacoes[Peso (kg)] * Avaliacoes[% Gordura] / 100)
		dataType: double
		formatString: 0.0
		lineageTag: 113fc40b-09d1-4e7a-b1b4-eb27ea5d35c3
		summarizeBy: none

	column 'Massa livre de gordura (kg)' = IF(ISBLANK(Avaliacoes[Massa adiposa (kg)]), BLANK(), Avaliacoes[Peso (kg)] - Avaliacoes[Massa adiposa (kg)])
		dataType: double
		formatString: 0.0
		lineageTag: d122cc47-049b-4e91-b70a-2e954b9a343e
		summarizeBy: none

	column 'IMC' = IF(ISBLANK(Avaliacoes[Altura (cm)]) || Avaliacoes[Altura (cm)] = 0, BLANK(), Avaliacoes[Peso (kg)] / (Avaliacoes[Altura (cm)] / 100) ^ 2)
		dataType: double
		formatString: 0.0
		lineageTag: 6e39b82e-0c61-4337-ab6d-739d96085042
		summarizeBy: none

	column 'Nº da avaliação' = COUNTROWS(FILTER(Avaliacoes, Avaliacoes[Atleta] = EARLIER(Avaliacoes[Atleta]) && Avaliacoes[Data] <= EARLIER(Avaliacoes[Data])))
		dataType: int64
		formatString: 0
		lineageTag: 7146bffb-ec7a-46a5-a9d1-d683d42361fb
		summarizeBy: none

	partition Avaliacoes = m
		mode: import
		source =
				let
				    Fonte = fnAba("Avaliações"),
				    Colunas = Table.SelectColumns(Fonte, {"Atleta", "Data", "Peso (kg)", "Altura (cm)", "Dobra tríceps (mm)", "Dobra subescapular (mm)", "Dobra peitoral (mm)", "Dobra axilar média (mm)", "Dobra suprailíaca (mm)", "Dobra abdominal (mm)", "Dobra coxa medial (mm)", "Circ. braço relaxado (cm)", "Circ. braço contraído (cm)", "Circ. cintura (cm)", "Circ. coxa medial (cm)", "Massa muscular (kg)", "% água corporal", "Observações"}, MissingField.UseNull),
				    Tipos = Table.TransformColumns(Colunas, {{"Atleta", fnTexto, type nullable text}, {"Data", fnData, type nullable date}, {"Peso (kg)", fnNumero, type nullable number}, {"Altura (cm)", fnNumero, type nullable number}, {"Dobra tríceps (mm)", fnNumero, type nullable number}, {"Dobra subescapular (mm)", fnNumero, type nullable number}, {"Dobra peitoral (mm)", fnNumero, type nullable number}, {"Dobra axilar média (mm)", fnNumero, type nullable number}, {"Dobra suprailíaca (mm)", fnNumero, type nullable number}, {"Dobra abdominal (mm)", fnNumero, type nullable number}, {"Dobra coxa medial (mm)", fnNumero, type nullable number}, {"Circ. braço relaxado (cm)", fnNumero, type nullable number}, {"Circ. braço contraído (cm)", fnNumero, type nullable number}, {"Circ. cintura (cm)", fnNumero, type nullable number}, {"Circ. coxa medial (cm)", fnNumero, type nullable number}, {"Massa muscular (kg)", fnNumero, type nullable number}, {"% água corporal", fnNumero, type nullable number}, {"Observações", fnTexto, type nullable text}}),
				    Linhas = Table.SelectRows(Tipos, each [Atleta] <> null),
				    Unicos = Linhas,
				    ComData = Table.SelectRows(Unicos, each [Data] <> null),
				    Resultado = ComData
				in
				    Resultado

	annotation PBI_ResultType = Table
