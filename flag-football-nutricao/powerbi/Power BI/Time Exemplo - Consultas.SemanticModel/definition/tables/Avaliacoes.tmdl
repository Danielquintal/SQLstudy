	measure 'Peso variação' = VAR n = CALCULATE(COUNTROWS(Avaliacoes), NOT ISBLANK(Avaliacoes[Peso (kg)])) VAR dif = [Peso atual] - [Peso inicial] RETURN IF(n < 2 || ISBLANK(dif), "1ª avaliação", IF(dif > 0, "+", IF(dif < 0, "−", "±")) & FORMAT(ABS(dif), "0.0") & " kg desde a 1ª")
