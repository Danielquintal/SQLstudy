		dataType: double
		formatString: 0.0
		lineageTag: 11343188-bc42-4c0b-abbf-025865ead9ee
		summarizeBy: average
		sourceColumn: Circ. coxa medial (cm)

	column 'Massa muscular (kg)'
		dataType: double
		formatString: 0.0
		lineageTag: cc3a2f54-6b9d-441a-91e1-59a546551e1c
