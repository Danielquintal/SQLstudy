		dataType: string
		lineageTag: 3db25dbb-99c6-4966-b4f1-b1947010f0c1
		summarizeBy: none
		sourceColumn: Posições

	column 'Consultas realizadas' = VAR a = Atletas[Atleta] RETURN COUNTROWS(FILTER(Consultas, Consultas[Atleta] = a && Consultas[Status] = "Realizada")) + 0
		dataType: int64
		formatString: 0
		lineageTag: de88e4b1-3e06-4ce3-bce4-4f02ead794a7
		summarizeBy: none

	column 'Próxima consulta' = VAR a = Atletas[Atleta] RETURN MINX(FILTER(Consultas, Consultas[Atleta] = a && Consultas[Status] IN {"Agendada", "Confirmada"} && Consultas[Início] >= NOW()), Consultas[Início])
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: 2b79259d-9236-4adf-84b7-740b350790d2
		summarizeBy: none

	column 'Acompanhamento' = IF(Atletas[Consultas realizadas] > 0, "Em acompanhamento", IF(NOT ISBLANK(Atletas[Próxima consulta]), "1ª consulta marcada", "Sem consulta"))
		dataType: string
		lineageTag: 12d4334f-3074-4808-868c-ce3c5498965a
		summarizeBy: none

	column 'Avaliações feitas' = VAR a = Atletas[Atleta] RETURN COUNTROWS(FILTER(Avaliacoes, Avaliacoes[Atleta] = a)) + 0
		dataType: int64
		formatString: 0
		lineageTag: 97ee25ef-ac21-4bdc-a799-48aa353e605d
		summarizeBy: none

	partition Atletas = m
		mode: import
		source =
				let
				    Fonte = fnAba("Atletas"),
				    Colunas = Table.SelectColumns(Fonte, {"Atleta", "Nome curto", "Posição 1", "Posição 2", "Posição 3", "Data de nascimento", "Peso informado (kg)", "Altura informada (m)", "QUAEST", "Status"}, MissingField.UseNull),
				    Tipos = Table.TransformColumns(Colunas, {{"Atleta", fnTexto, type nullable text}, {"Nome curto", fnTexto, type nullable text}, {"Posição 1", fnTexto, type nullable text}, {"Posição 2", fnTexto, type nullable text}, {"Posição 3", fnTexto, type nullable text}, {"Data de nascimento", fnData, type nullable date}, {"Peso informado (kg)", fnNumero, type nullable number}, {"Altura informada (m)", fnNumero, type nullable number}, {"QUAEST", fnTexto, type nullable text}, {"Status", fnTexto, type nullable text}}),
				    Linhas = Table.SelectRows(Tipos, each [Atleta] <> null),
				    Unicos = Table.Distinct(Linhas, {"Atleta"}),
				    Posicoes = Table.AddColumn(Unicos, "Posições", each Text.Combine(List.RemoveNulls({[Posição 1], [Posição 2], [Posição 3]}), "/"), type text),
				    Curto = Table.ReplaceValue(Posicoes, each [Nome curto], each if [Nome curto] = null then [Atleta] else [Nome curto], Replacer.ReplaceValue, {"Nome curto"}),
				    Resultado = Table.ReplaceValue(Curto, each [Status], each if [Status] = null then "Ativo" else [Status], Replacer.ReplaceValue, {"Status"})
				in
				    Resultado

	annotation PBI_ResultType = Table
