table Atletas
	lineageTag: 2d25125c-e3c6-4d63-a146-5beff2e6248a

	measure 'Total de atletas' = CALCULATE(COUNTROWS(Atletas), Atletas[Status] <> "Inativo") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: ee2e77ef-5321-4fc4-a968-c37e18247934

	measure 'QUAEST respondidos' = CALCULATE(COUNTROWS(Atletas), Atletas[QUAEST] = "Respondido", Atletas[Status] <> "Inativo") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: 16d50e25-9b1d-48bb-979a-30f3558f3d35

	measure 'Em acompanhamento' = CALCULATE(COUNTROWS(Atletas), Atletas[Acompanhamento] = "Em acompanhamento", Atletas[Status] <> "Inativo") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: f18a3b6a-10df-44d7-8040-66ca32f7ac9f

	measure 'Sem consulta' = CALCULATE(COUNTROWS(Atletas), Atletas[Acompanhamento] = "Sem consulta", Atletas[Status] <> "Inativo") + 0
		formatString: 0
		displayFolder: Relatório
		lineageTag: 55b01e7f-fa24-4404-a3db-1ceb289e44eb

	measure '% em acompanhamento' = DIVIDE([Em acompanhamento], [Total de atletas])
		formatString: 0%
		displayFolder: Relatório
		lineageTag: c83af76b-5f7d-442e-a679-a839991b50d8

	measure 'Atleta selecionado' = IF(HASONEVALUE(Atletas[Atleta]), VALUES(Atletas[Atleta]), "Todos os atletas · escolha um atleta no filtro")
		displayFolder: Relatório
		lineageTag: b7e3081d-d48e-49b1-acfb-1944bd59189e

	measure 'Ficha do atleta' = IF(HASONEVALUE(Atletas[Atleta]), "Posições: " & COALESCE(SELECTEDVALUE(Atletas[Posições]), "–") & "   ·   " & SELECTEDVALUE(Atletas[Acompanhamento]) & "   ·   " & FORMAT(SELECTEDVALUE(Atletas[Consultas realizadas]), "0") & " consulta(s) realizada(s)", "Time Exemplo · time de flag football")
		displayFolder: Relatório
		lineageTag: c34b97d3-f983-420a-9d2e-54e1151ffb4f

	measure 'Próxima consulta (texto)' = VAR d = CALCULATE(MIN(Consultas[Início]), Consultas[Status] IN {"Agendada", "Confirmada"}, Consultas[Início] >= NOW()) RETURN IF(ISBLANK(d), "Nenhuma consulta marcada", FORMAT(d, "dd/mm/yyyy") & " às " & FORMAT(d, "hh:nn"))
		displayFolder: Relatório
		lineageTag: 62ecb275-5c37-4139-bed9-f18d6f1ba11a

	measure 'Último resumo' = VAR d = CALCULATE(MAX(Consultas[Início]), Consultas[Status] = "Realizada") RETURN IF(ISBLANK(d), "Nenhuma consulta realizada ainda.", FORMAT(d, "dd/mm/yyyy") & " · " & COALESCE(CALCULATE(MAX(Consultas[Resumo e condutas]), Consultas[Início] = d, Consultas[Status] = "Realizada"), "(sem resumo escrito)"))
		displayFolder: Relatório
		lineageTag: e2a0d8a3-bfe6-4615-b4a2-371396a1d80a

	measure 'Próximo retorno (texto)' = VAR d = CALCULATE(MAX(Consultas[Próximo retorno]), Consultas[Status] = "Realizada") RETURN IF(ISBLANK(d), "–", FORMAT(d, "dd/mm/yyyy") & IF(d < TODAY(), " (atrasado)", ""))
		displayFolder: Relatório
		lineageTag: 677b3bae-ae32-4da9-b86b-52675fd36727

	measure 'Cor do retorno' = VAR d = CALCULATE(MAX(Consultas[Próximo retorno]), Consultas[Status] = "Realizada") RETURN IF(NOT ISBLANK(d) && d < TODAY(), "#C2452D", "#1C2430")
		displayFolder: Relatório
		lineageTag: e46431c9-bbfd-4ddb-8e0a-36875a31a887

